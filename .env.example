# Kobun environment variables template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Kaggle API — used to download Kuzushiji-49 and the Kaggle Kuzushiji
# Recognition competition dataset via `ml/scripts/download_data.py`.
# Generate credentials at: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Weights & Biases — experiment tracking and hyperparameter sweeps during
# model training. Project: kobun-classification.
# Get API key at: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key

# HuggingFace Hub — upload trained model weights/cards and sync the
# `apps/space/` folder to the public HuggingFace Space. Token role must be
# "write".
# Create token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_write_token

# Google Gemini — trilingual translation (JP / EN / ID) at inference time.
# In production this secret lives in HuggingFace Space Secrets, not Vercel.
# Get API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here
